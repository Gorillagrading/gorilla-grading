# Copia este archivo como .env y rellena los valores. .env no se versiona.

# Supabase > Project Settings > Database > Connection string.
# Runtime de la API: pooler en modo transacción (puerto 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Migraciones y seed: pooler en modo sesión (puerto 5432) o conexión directa.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Clave para cifrar códigos de acceso e IPs (mínimo 32 caracteres, secreta).
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Clave de las tareas programadas (el cron que avanza los pedidos). En Vercel la variable se llama
# CRON_SECRET y Vercel la envía sola al cron. Genérala igual que AUTH_SECRET.
CRON_SECRET=

# Orígenes extra que pueden llamar a la API desde el navegador, separados por comas.
# En desarrollo ya se admite http://localhost:5173. En producción, la URL de la web.
APP_ORIGINS=

# Puerto del servidor local de la API (npm run dev:api).
API_PORT=8787

# Envío de emails por SMTP (IONOS, SES, Postmark…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gorilla Grading <no-reply@tudominio.com>"

# Fotos de las cartas (Supabase Storage, bucket privado)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=lab-private
# Solo si la subida directa del navegador devuelve 401:
SUPABASE_ANON_KEY=

# Firma de certificados (Ed25519). Genera los valores con: npm run keys:generate
CERT_KEY_ID=
CERT_SIGNING_KEY=
# Dirección pública que lleva el QR del slab:
PUBLIC_BASE_URL=https://gorillagrading.com
